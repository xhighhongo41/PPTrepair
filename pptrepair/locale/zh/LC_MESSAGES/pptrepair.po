msgstr "正在下载仅云端文件: {path}"

msgid "corrupted: file is empty (all content lost)"
msgstr "损坏: 文件为空(全部内容已丢失)"

msgid "corrupted: file is (almost) entirely zero-filled"
msgstr "损坏: 文件(几乎)完全被零填充"

