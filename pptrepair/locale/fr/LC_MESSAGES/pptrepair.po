msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr\n"

msgid "=== Scan summary ==="
msgstr "=== Résumé de l'analyse ==="

msgid "Category"
msgstr "Catégorie"

msgid "Corrupted files:"
msgstr "Fichiers endommagés :"

msgid "Created"
msgstr "Créé le"

msgid "Creator"
msgstr "Auteur"

msgid "Diagnostic fingerprints were written to {path}; please attach them to a new issue at {url}."
msgstr "Les empreintes de diagnostic ont été écrites dans {path} ; veuillez les joindre à un nouveau ticket sur {url}."

msgid "Errors:"
msgstr "Erreurs :"

msgid "Hint: OneDrive's web version history may hold an older intact copy of this file."
msgstr "Astuce : l'historique des versions web de OneDrive peut contenir une copie intacte antérieure de ce fichier."

msgid "Hint: pass --allow-download to also examine cloud-only files (this may take long and use significant disk space)."
msgstr "Astuce : utilisez --allow-download pour examiner aussi les fichiers uniquement dans le cloud (cela peut être long et utiliser beaucoup d'espace disque)."

msgid "Hint: pass --force to overwrite the existing output."
msgstr "Astuce : utilisez --force pour écraser la sortie existante."

msgid "Hint: re-run with --report DIR to save shareable diagnostic fingerprints for these files."
msgstr "Astuce : relancez avec --report DIR pour enregistrer des empreintes de diagnostic partageables."

msgid "Last Modified By"
msgstr "Dernière modification par"

msgid "Lost entries: {n}"
msgstr "Entrées perdues : {n}"

msgid "Lost slides: {numbers}"
msgstr "Diapositives perdues : {numbers}"

msgid "Mode: {mode}"
msgstr "Mode : {mode}"

msgid "Modified"
msgstr "Modifié le"

msgid "No slide-title heading found; listing all recovered title strings:"
msgstr "Aucun en-tête de titres de diapositives trouvé ; liste de toutes les chaînes de titre récupérées :"

msgid "Not examined: {n} cloud-only file(s) were skipped without downloading."
msgstr "Non examinés : {n} fichier(s) uniquement dans le cloud ont été ignorés sans être téléchargés."

msgid "Note: {n} additional unknown-pattern file(s) were not fingerprinted because of the per-run cap."
msgstr "Remarque : {n} fichier(s) supplémentaire(s) à motif inconnu n'ont pas été empreintés en raison de la limite par exécution."

msgid "Note: {n} of the not_a_zip file(s) look like encrypted or legacy Office documents, not OneDrive corruption."
msgstr "Remarque : {n} des fichiers not_a_zip ressemblent à des documents Office chiffrés ou d'un format ancien, pas à une corruption OneDrive."

msgid "Nothing to repair: the file is already an intact PowerPoint package."
msgstr "Rien à réparer : le fichier est déjà un paquet PowerPoint intact."

msgid "Output: {path}"
msgstr "Sortie : {path}"

msgid "Re-check verdict: {verdict}"
msgstr "Verdict de la revérification : {verdict}"

msgid "Salvaged entries: {ok} of {total}"
msgstr "Entrées récupérées : {ok} sur {total}"

msgid "Scanned: {n} file(s)"
msgstr "Analysés : {n} fichier(s)"

msgid "Series"
msgstr "Série"

msgid "Skipped: {n} Office temp file(s)"
msgstr "Ignorés : {n} fichier(s) temporaire(s) Office"

msgid "Skipped: {n} legacy .ppt file(s)"
msgstr "Ignorés : {n} fichier(s) .ppt hérité(s)"

msgid "Slide titles recovered from document properties:"
msgstr "Titres de diapositives récupérés depuis les propriétés du document :"

msgid "Slides recovered: {ok} of {total}"
msgstr "Diapositives récupérées : {ok} sur {total}"

msgid "The recovery folder groups salvaged content by kind: images/ and media/ hold pictures, audio and video; texts/ holds best-effort recovered text; charts/ holds chart XML plus cached data; parts/ holds every salvaged part in its original, raw form."
msgstr "Le dossier de récupération regroupe le contenu récupéré par type : images/ et media/ contiennent les images, l'audio et la vidéo ; texts/ contient le texte récupéré ; charts/ contient le XML des graphiques et leurs données en cache ; parts/ contient chaque partie récupérée sous sa forme brute d'origine."

msgid "Title"
msgstr "Titre"

msgid "Unknown pattern: {n} file(s) did not match any known corruption pattern."
msgstr "Motif inconnu : {n} fichier(s) ne correspondaient à aucun motif de dommage connu."

msgid "Unrepairable: no recoverable content was found."
msgstr "Irréparable : aucun contenu récupérable n'a été trouvé."

msgid "Value"
msgstr "Valeur"

msgid "Verdict: {verdict} ({label})"
msgstr "Verdict : {verdict} ({label})"

msgid "Warnings:"
msgstr "Avertissements :"

msgid "corrupted: file tail truncated"
msgstr "endommagé : la fin du fichier est tronquée"

msgid "corrupted: leading region overwritten with foreign data"
msgstr "endommagé : la région initiale a été écrasée par des données étrangères"

msgid "corrupted: leading region overwritten with zeros"
msgstr "endommagé : la région initiale a été écrasée par des zéros"

msgid "corrupted: mixture of two file versions"
msgstr "endommagé : mélange de deux versions du fichier"

msgid "corrupted: unrecognized damage pattern"
msgstr "endommagé : schéma de dommage non reconnu"

msgid "intact PowerPoint package"
msgstr "paquet PowerPoint intact"

msgid "not a ZIP-based file"
msgstr "fichier non basé sur ZIP"

msgid "Downloading cloud-only file: {path}"
msgstr "Téléchargement du fichier uniquement dans le cloud : {path}"

msgid "corrupted: file is empty (all content lost)"
msgstr "endommagé : le fichier est vide (tout le contenu est perdu)"

msgid "corrupted: file is (almost) entirely zero-filled"
msgstr "endommagé : le fichier est (presque) entièrement rempli de zéros"

msgid "corrupted: interior region damaged, archive index intact"
msgstr "endommagé : région intérieure endommagée, index de l'archive intact"

msgid "corrupted: intact archive followed by foreign data"
msgstr "endommagé : archive intacte suivie de données étrangères"

msgid "Removed {n} bytes of foreign data that followed the archive; the leading archive was kept unmodified."
msgstr "{n} octets de données étrangères qui suivaient l'archive ont été supprimés ; l'archive initiale a été conservée sans modification."

msgid "Hint: no content survives inside this file. Check the OneDrive recycle bin, other devices' local copies, and any backups; version history rarely helps with this damage pattern."
msgstr "Astuce : aucun contenu ne subsiste dans ce fichier. Vérifiez la corbeille OneDrive, les copies locales sur d'autres appareils et toute sauvegarde ; l'historique des versions aide rarement avec ce type de dommage."

msgid "Removed {e} stale reference(s) from {p} rebuilt part(s)."
msgstr "{e} référence(s) obsolète(s) ont été supprimée(s) de {p} partie(s) reconstruite(s)."

msgid "Unresolved references after repair: {n}"
msgstr "Références non résolues après la réparation : {n}"

msgid "Note: these unresolved references existed in the original archive and were left untouched (the recovered file is byte-identical to the original)."
msgstr "Remarque : ces références non résolues existaient déjà dans l'archive d'origine et n'ont pas été modifiées (le fichier récupéré est identique octet par octet à l'original)."

msgid "=== Repair summary ==="
msgstr "=== Résumé de la réparation ==="

msgid "Repaired: {n} file(s)"
msgstr "Réparés : {n} fichier(s)"

msgid "Unrepairable: {n} file(s)"
msgstr "Irréparables : {n} fichier(s)"

msgid "Encrypted or legacy Office file(s) (not attempted): {n}"
msgstr "Fichier(s) Office chiffré(s) ou d'un format ancien (non tentés) : {n}"

msgid "No content survives: {n} file(s)"
msgstr "Aucun contenu ne subsiste : {n} fichier(s)"

msgid "Skipped (output exists): {n} file(s)"
msgstr "Ignorés (la sortie existe déjà) : {n} fichier(s)"

msgid "Failed: {n} file(s)"
msgstr "Échoués : {n} fichier(s)"

msgid "Planned: {n} file(s)"
msgstr "Prévus : {n} fichier(s)"

msgid "dry run: nothing was written."
msgstr "dry-run : rien n'a été écrit."

msgid "Repairs:"
msgstr "Réparations :"

msgid "corrupted: overwritten with fragments of another ZIP archive"
msgstr "endommagé : écrasé par des fragments d'une autre archive ZIP"

msgid "corrupted: archive body largely overwritten in place"
msgstr "endommagé : le corps de l'archive a été en grande partie écrasé sur place"

msgid "=== Salvage summary ==="
msgstr "=== Résumé du sauvetage ==="

msgid "Nothing to salvage: the file is already an intact PowerPoint package."
msgstr "Rien à sauver : le fichier est déjà un paquet PowerPoint intact."

msgid "Entries recovered: {n}"
msgstr "Entrées récupérées : {n}"

msgid "Images carved: {n}"
msgstr "Images extraites : {n}"

msgid "Partial XML parts: {n}"
msgstr "Parties XML partielles : {n}"

msgid "Text lines recovered: {n}"
msgstr "Lignes de texte récupérées : {n}"

msgid "Note: carved images may contain unrelated data that overwrote the file."
msgstr "Remarque : les images extraites peuvent contenir des données étrangères qui ont écrasé le fichier."

msgid "Nothing could be salvaged from this file."
msgstr "Rien n'a pu être sauvé de ce fichier."

msgid "  restore candidate: {path} ({reason})"
msgstr "  candidat de restauration : {path} ({reason})"

msgid "  (+{n} more restore candidates)"
msgstr "  (+{n} candidat(s) de restauration supplémentaire(s))"

msgid "same name and size"
msgstr "même nom et même taille"

msgid "same size only"
msgstr "même taille seulement"

msgid "same name only"
msgstr "même nom seulement"

msgid "=== Merge summary ==="
msgstr "=== Résumé de la fusion ==="

msgid "Guarantee: {guarantee}"
msgstr "Garantie : {guarantee}"

msgid "Entries by source:"
msgstr "Entrées par source :"

msgid "Warning: part of the output comes from a different version and is not guaranteed to be identical to the original."
msgstr "Avertissement : une partie du résultat provient d'une version différente et n'est pas garantie identique à l'original."

msgid "Notes:"
msgstr "Remarques :"

msgid "Candidate-tier source not used: {path} (pass --allow-candidate, --yes, or confirm the prompt to include it)"
msgstr "Source de niveau candidate non utilisée : {path} (passez --allow-candidate, --yes, ou confirmez l'invite pour l'inclure)"

msgid "Lineage-tier source not used: {path} (pass --yes or confirm the prompt to include it)"
msgstr "Source de niveau lineage non utilisée : {path} (passez --yes ou confirmez l'invite pour l'inclure)"

msgid "Source not used (not the same origin): {path}"
msgstr "Source non utilisée (origine différente) : {path}"

msgid "Source: {path}"
msgstr "Source : {path}"

msgid "Tier: {tier}"
msgstr "Niveau : {tier}"

msgid "Size match: {value}"
msgstr "Correspondance de taille : {value}"

msgid "Triple ratio: {pct}%"
msgstr "Taux triple : {pct}%"

msgid "Name ratio: {pct}%"
msgstr "Taux de noms : {pct}%"

msgid "Media ratio: {pct}%"
msgstr "Taux de médias : {pct}%"

msgid "Lineage score: {value}"
msgstr "Score de lignée : {value}"

msgid "Use this source for the merge? [y/N] "
msgstr "Utiliser cette source pour la fusion ? [y/N] "

msgid "Merge candidates:"
msgstr "Candidats à la fusion :"

msgid "  {size} bytes: {files}"
msgstr "  {size} octets : {files}"

msgid "    These files may be the same saved version and could be repaired together into one file with pptrepair merge."
msgstr "    Ces fichiers pourraient être la même version enregistrée et pourraient être réparés ensemble en un seul fichier avec pptrepair merge."

msgid "  lineage candidate: {path} (score {score})"
msgstr "  candidat de lignée : {path} (score {score})"

msgid "The merge target cannot be a file inside an archive: {path}. Extract it to a plain file and pass that instead."
msgstr "La cible de la fusion ne peut pas être un fichier situé dans une archive : {path}. Extrayez-le vers un fichier normal et indiquez celui-ci à la place."

