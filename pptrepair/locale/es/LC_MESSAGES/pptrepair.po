msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es\n"

msgid "=== Scan summary ==="
msgstr "=== Resumen del análisis ==="

msgid "Category"
msgstr "Categoría"

msgid "Corrupted files:"
msgstr "Archivos dañados:"

msgid "Created"
msgstr "Creado"

msgid "Creator"
msgstr "Autor"

msgid "Diagnostic fingerprints were written to {path}; please attach them to a new issue at {url}."
msgstr "Las huellas de diagnóstico se guardaron en {path}; adjúntelas a un nuevo issue en {url}."

msgid "Errors:"
msgstr "Errores:"

msgid "Hint: OneDrive's web version history may hold an older intact copy of this file."
msgstr "Sugerencia: el historial de versiones web de OneDrive puede conservar una copia intacta anterior de este archivo."

msgid "Hint: pass --allow-download to also examine cloud-only files (this may take long and use significant disk space)."
msgstr "Sugerencia: use --allow-download para examinar también los archivos exclusivos de la nube (esto puede tardar mucho y usar mucho espacio en disco)."

msgid "Hint: pass --force to overwrite the existing output."
msgstr "Sugerencia: use --force para sobrescribir la salida existente."

msgid "Hint: re-run with --report DIR to save shareable diagnostic fingerprints for these files."
msgstr "Sugerencia: vuelva a ejecutar con --report DIR para guardar huellas de diagnóstico compartibles."

msgid "Last Modified By"
msgstr "Última modificación por"

msgid "Lost entries: {n}"
msgstr "Entradas perdidas: {n}"

msgid "Lost slides: {numbers}"
msgstr "Diapositivas perdidas: {numbers}"

msgid "Mode: {mode}"
msgstr "Modo: {mode}"

msgid "Modified"
msgstr "Modificado"

msgid "No slide-title heading found; listing all recovered title strings:"
msgstr "No se encontró el encabezado de títulos de diapositivas; se listan todas las cadenas de título recuperadas:"

msgid "Not examined: {n} cloud-only file(s) were skipped without downloading."
msgstr "No examinados: se omitieron {n} archivo(s) exclusivo(s) de la nube sin descargarlos."

msgid "Note: {n} additional unknown-pattern file(s) were not fingerprinted because of the per-run cap."
msgstr "Nota: {n} archivo(s) adicionales de patrón desconocido no se pudieron registrar por el límite por ejecución."

msgid "Note: {n} of the not_a_zip file(s) look like encrypted or legacy Office documents, not OneDrive corruption."
msgstr "Nota: {n} de los archivos not_a_zip parecen documentos de Office cifrados o de formato antiguo, no daño de OneDrive."

msgid "Nothing to repair: the file is already an intact PowerPoint package."
msgstr "Nada que reparar: el archivo ya es un paquete de PowerPoint intacto."

msgid "Output: {path}"
msgstr "Salida: {path}"

msgid "Re-check verdict: {verdict}"
msgstr "Veredicto de la nueva comprobación: {verdict}"

msgid "Salvaged entries: {ok} of {total}"
msgstr "Entradas rescatadas: {ok} de {total}"

msgid "Scanned: {n} file(s)"
msgstr "Analizados: {n} archivo(s)"

msgid "Series"
msgstr "Serie"

msgid "Skipped: {n} Office temp file(s)"
msgstr "Omitidos: {n} archivo(s) temporal(es) de Office"

msgid "Skipped: {n} legacy .ppt file(s)"
msgstr "Omitidos: {n} archivo(s) .ppt antiguos"

msgid "Slide titles recovered from document properties:"
msgstr "Títulos de diapositivas recuperados de las propiedades del documento:"

msgid "Slides recovered: {ok} of {total}"
msgstr "Diapositivas recuperadas: {ok} de {total}"

msgid "The recovery folder groups salvaged content by kind: images/ and media/ hold pictures, audio and video; texts/ holds best-effort recovered text; charts/ holds chart XML plus cached data; parts/ holds every salvaged part in its original, raw form."
msgstr "La carpeta de recuperación agrupa el contenido rescatado por tipo: images/ y media/ contienen imágenes, audio y vídeo; texts/ contiene el texto recuperado; charts/ contiene el XML de los gráficos y sus datos en caché; parts/ contiene cada parte rescatada en su forma original sin procesar."

msgid "Title"
msgstr "Título"

msgid "Unknown pattern: {n} file(s) did not match any known corruption pattern."
msgstr "Patrón desconocido: {n} archivo(s) no coincidieron con ningún patrón de daño conocido."

msgid "Unrepairable: no recoverable content was found."
msgstr "Irreparable: no se encontró contenido recuperable."

msgid "Value"
msgstr "Valor"

msgid "Verdict: {verdict} ({label})"
msgstr "Veredicto: {verdict} ({label})"

msgid "Warnings:"
msgstr "Advertencias:"

msgid "corrupted: file tail truncated"
msgstr "dañado: el final del archivo está truncado"

msgid "corrupted: leading region overwritten with foreign data"
msgstr "dañado: la región inicial fue sobrescrita con datos ajenos"

msgid "corrupted: leading region overwritten with zeros"
msgstr "dañado: la región inicial fue sobrescrita con ceros"

msgid "corrupted: mixture of two file versions"
msgstr "dañado: mezcla de dos versiones del archivo"

msgid "corrupted: unrecognized damage pattern"
msgstr "dañado: patrón de daño no reconocido"

msgid "intact PowerPoint package"
msgstr "paquete de PowerPoint intacto"

msgid "not a ZIP-based file"
msgstr "no es un archivo basado en ZIP"

msgid "Downloading cloud-only file: {path}"
msgstr "Descargando archivo exclusivo de la nube: {path}"

msgid "corrupted: file is empty (all content lost)"
msgstr "dañado: el archivo está vacío (todo el contenido se ha perdido)"

msgid "corrupted: file is (almost) entirely zero-filled"
msgstr "dañado: el archivo está (casi) completamente relleno de ceros"

msgid "corrupted: interior region damaged, archive index intact"
msgstr "dañado: la región interior está dañada, el índice del archivo está intacto"

msgid "corrupted: intact archive followed by foreign data"
msgstr "dañado: archivo intacto seguido de datos ajenos"

msgid "Removed {n} bytes of foreign data that followed the archive; the leading archive was kept unmodified."
msgstr "Se eliminaron {n} bytes de datos ajenos que seguían al archivo; el archivo inicial se conservó sin modificar."

msgid "Hint: no content survives inside this file. Check the OneDrive recycle bin, other devices' local copies, and any backups; version history rarely helps with this damage pattern."
msgstr "Sugerencia: no sobrevive ningún contenido dentro de este archivo. Revise la papelera de reciclaje de OneDrive, las copias locales de otros dispositivos y cualquier copia de seguridad; el historial de versiones rara vez ayuda con este patrón de daño."

msgid "Removed {e} stale reference(s) from {p} rebuilt part(s)."
msgstr "Se eliminaron {e} referencia(s) obsoletas de {p} parte(s) reconstruidas."

msgid "Unresolved references after repair: {n}"
msgstr "Referencias sin resolver tras la reparación: {n}"

msgid "Note: these unresolved references existed in the original archive and were left untouched (the recovered file is byte-identical to the original)."
msgstr "Nota: estas referencias sin resolver ya existían en el archivo original y no se modificaron (el archivo recuperado es idéntico byte a byte al original)."

msgid "=== Repair summary ==="
msgstr "=== Resumen de reparación ==="

msgid "Repaired: {n} file(s)"
msgstr "Reparados: {n} archivo(s)"

msgid "Unrepairable: {n} file(s)"
msgstr "Irreparables: {n} archivo(s)"

msgid "Encrypted or legacy Office file(s) (not attempted): {n}"
msgstr "Archivo(s) de Office cifrados o de formato antiguo (no intentados): {n}"

msgid "No content survives: {n} file(s)"
msgstr "Sin contenido recuperable: {n} archivo(s)"

msgid "Skipped (output exists): {n} file(s)"
msgstr "Omitidos (la salida ya existe): {n} archivo(s)"

msgid "Failed: {n} file(s)"
msgstr "Fallidos: {n} archivo(s)"

msgid "Planned: {n} file(s)"
msgstr "Planificados: {n} archivo(s)"

msgid "dry run: nothing was written."
msgstr "dry-run: no se escribió nada."

msgid "Repairs:"
msgstr "Reparaciones:"

msgid "corrupted: overwritten with fragments of another ZIP archive"
msgstr "dañado: sobrescrito con fragmentos de otro archivo ZIP"

msgid "corrupted: archive body largely overwritten in place"
msgstr "dañado: el cuerpo del archivo fue sobrescrito en gran parte in situ"

msgid "=== Salvage summary ==="
msgstr "=== Resumen del rescate ==="

msgid "Nothing to salvage: the file is already an intact PowerPoint package."
msgstr "Nada que rescatar: el archivo ya es un paquete de PowerPoint intacto."

msgid "Entries recovered: {n}"
msgstr "Entradas recuperadas: {n}"

msgid "Images carved: {n}"
msgstr "Imágenes extraídas: {n}"

msgid "Partial XML parts: {n}"
msgstr "Partes XML parciales: {n}"

msgid "Text lines recovered: {n}"
msgstr "Líneas de texto recuperadas: {n}"

msgid "Note: carved images may contain unrelated data that overwrote the file."
msgstr "Nota: las imágenes extraídas pueden contener datos ajenos que sobrescribieron el archivo."

msgid "Nothing could be salvaged from this file."
msgstr "No se pudo rescatar nada de este archivo."

msgid "  restore candidate: {path} ({reason})"
msgstr "  candidato de restauración: {path} ({reason})"

msgid "  (+{n} more restore candidates)"
msgstr "  (+{n} candidatos de restauración más)"

msgid "same name and size"
msgstr "mismo nombre y tamaño"

msgid "same size only"
msgstr "mismo tamaño solamente"

msgid "same name only"
msgstr "mismo nombre solamente"

msgid "=== Merge summary ==="
msgstr "=== Resumen de fusión ==="

msgid "Guarantee: {guarantee}"
msgstr "Garantía: {guarantee}"

msgid "Entries by source:"
msgstr "Entradas por origen:"

msgid "Warning: part of the output comes from a different version and is not guaranteed to be identical to the original."
msgstr "Advertencia: parte de la salida proviene de una versión diferente y no se garantiza que sea idéntica al original."

msgid "Notes:"
msgstr "Notas:"

msgid "Candidate-tier source not used: {path} (pass --allow-candidate, --yes, or confirm the prompt to include it)"
msgstr "Origen de nivel candidate no utilizado: {path} (pase --allow-candidate, --yes, o confirme la petición para incluirlo)"

msgid "Lineage-tier source not used: {path} (pass --yes or confirm the prompt to include it)"
msgstr "Origen de nivel lineage no utilizado: {path} (pase --yes o confirme la petición para incluirlo)"

msgid "Source not used (not the same origin): {path}"
msgstr "Origen no utilizado (no es el mismo origen): {path}"

msgid "Source: {path}"
msgstr "Origen: {path}"

msgid "Tier: {tier}"
msgstr "Nivel: {tier}"

msgid "Size match: {value}"
msgstr "Coincidencia de tamaño: {value}"

msgid "Triple ratio: {pct}%"
msgstr "Proporción triple: {pct}%"

msgid "Name ratio: {pct}%"
msgstr "Proporción de nombres: {pct}%"

msgid "Media ratio: {pct}%"
msgstr "Proporción de multimedia: {pct}%"

msgid "Lineage score: {value}"
msgstr "Puntuación de linaje: {value}"

msgid "Use this source for the merge? [y/N] "
msgstr "¿Usar este origen para la fusión? [y/N] "

msgid "Merge candidates:"
msgstr "Candidatos de fusión:"

msgid "  {size} bytes: {files}"
msgstr "  {size} bytes: {files}"

msgid "    These files may be the same saved version and could be repaired together into one file with pptrepair merge."
msgstr "    Estos archivos pueden ser la misma versión guardada y podrían repararse juntos en un solo archivo con pptrepair merge."

msgid "  lineage candidate: {path} (score {score})"
msgstr "  candidato de linaje: {path} (puntuación {score})"

