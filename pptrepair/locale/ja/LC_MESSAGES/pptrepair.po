msgstr "未検査: {n} 件のクラウド専用ファイルはダウンロードせずにスキップされました。"

msgid "Note: {n} additional unknown-pattern file(s) were not fingerprinted because of the per-run cap."
msgstr "注記: 未知パターンのファイルのうち {n} 件は、1回の実行あたりの上限のためフィンガープリントを記録できませんでした。"

msgid "Note: {n} of the not_a_zip file(s) look like encrypted or legacy Office documents, not OneDrive corruption."
msgstr "注記: not_a_zip と判定されたファイルのうち {n} 件は、暗号化済みまたはレガシー形式のOfficeファイルの可能性があります(OneDriveの破損ではありません)。"

msgid "Nothing to repair: the file is already an intact PowerPoint package."
msgstr "修復の必要はありません: このファイルは無傷のPowerPointパッケージです。"

msgid "Output: {path}"
msgstr "出力先: {path}"

msgid "Re-check verdict: {verdict}"
msgstr "再診断結果: {verdict}"

msgid "Salvaged entries: {ok} of {total}"
msgstr "救出エントリ: {total} 件中 {ok} 件"

msgid "Scanned: {n} file(s)"
msgstr "スキャン件数: {n} 件"

msgid "Series"
msgstr "系列"

