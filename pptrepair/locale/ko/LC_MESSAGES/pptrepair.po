msgstr "=== 복구 요약 ==="

msgid "Repaired: {n} file(s)"
msgstr "복구됨: {n}개"

msgid "Unrepairable: {n} file(s)"
msgstr "복구 불가: {n}개"

msgid "Encrypted or legacy Office file(s) (not attempted): {n}"
msgstr "암호화되었거나 레거시 Office 파일(시도하지 않음): {n}개"

msgid "No content survives: {n} file(s)"
msgstr "남아 있는 내용 없음: {n}개"

msgid "Skipped (output exists): {n} file(s)"
msgstr "건너뜀(출력이 이미 존재함): {n}개"

msgid "Failed: {n} file(s)"
msgstr "실패: {n}개"

msgid "Planned: {n} file(s)"
msgstr "예정: {n}개"

