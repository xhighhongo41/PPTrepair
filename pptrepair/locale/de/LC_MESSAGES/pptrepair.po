msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de\n"

msgid "=== Scan summary ==="
msgstr "=== Scan-Zusammenfassung ==="

msgid "Category"
msgstr "Kategorie"

msgid "Corrupted files:"
msgstr "Beschädigte Dateien:"

msgid "Created"
msgstr "Erstellt"

msgid "Creator"
msgstr "Autor"

msgid "Diagnostic fingerprints were written to {path}; please attach them to a new issue at {url}."
msgstr "Diagnose-Fingerabdrücke wurden nach {path} geschrieben; bitte fügen Sie sie einem neuen Issue unter {url} bei."

msgid "Errors:"
msgstr "Fehler:"

msgid "Hint: OneDrive's web version history may hold an older intact copy of this file."
msgstr "Hinweis: Der Web-Versionsverlauf von OneDrive enthält möglicherweise eine ältere, intakte Kopie dieser Datei."

msgid "Hint: pass --allow-download to also examine cloud-only files (this may take long and use significant disk space)."
msgstr "Hinweis: Verwenden Sie --allow-download, um auch reine Cloud-Dateien zu untersuchen (dies kann lange dauern und erheblichen Speicherplatz beanspruchen)."

msgid "Hint: pass --force to overwrite the existing output."
msgstr "Hinweis: Verwenden Sie --force, um die vorhandene Ausgabe zu überschreiben."

msgid "Hint: re-run with --report DIR to save shareable diagnostic fingerprints for these files."
msgstr "Hinweis: Führen Sie den Scan erneut mit --report DIR aus, um teilbare Diagnose-Fingerabdrücke zu speichern."

msgid "Last Modified By"
msgstr "Zuletzt geändert von"

msgid "Lost entries: {n}"
msgstr "Verlorene Einträge: {n}"

msgid "Lost slides: {numbers}"
msgstr "Verlorene Folien: {numbers}"

msgid "Mode: {mode}"
msgstr "Modus: {mode}"

msgid "Modified"
msgstr "Geändert"

msgid "No slide-title heading found; listing all recovered title strings:"
msgstr "Keine Folientitel-Überschrift gefunden; alle wiederhergestellten Titelzeichenfolgen werden aufgelistet:"

msgid "Not examined: {n} cloud-only file(s) were skipped without downloading."
msgstr "Nicht untersucht: {n} reine Cloud-Datei(en) wurden ohne Download übersprungen."

msgid "Note: {n} additional unknown-pattern file(s) were not fingerprinted because of the per-run cap."
msgstr "Hinweis: {n} zusätzliche Datei(en) mit unbekanntem Muster wurden wegen der Obergrenze pro Lauf nicht als Fingerabdruck gespeichert."

msgid "Note: {n} of the not_a_zip file(s) look like encrypted or legacy Office documents, not OneDrive corruption."
msgstr "Hinweis: {n} der als not_a_zip eingestuften Dateien sehen wie verschlüsselte oder veraltete Office-Dokumente aus, nicht wie eine OneDrive-Beschädigung."

msgid "Nothing to repair: the file is already an intact PowerPoint package."
msgstr "Nichts zu reparieren: Die Datei ist bereits ein intaktes PowerPoint-Paket."

msgid "Output: {path}"
msgstr "Ausgabe: {path}"

msgid "Re-check verdict: {verdict}"
msgstr "Ergebnis der erneuten Prüfung: {verdict}"

msgid "Salvaged entries: {ok} of {total}"
msgstr "Gerettete Einträge: {ok} von {total}"

msgid "Scanned: {n} file(s)"
msgstr "Gescannt: {n} Datei(en)"

msgid "Series"
msgstr "Reihe"

msgid "Skipped: {n} Office temp file(s)"
msgstr "Übersprungen: {n} Office-Temporärdatei(en)"

msgid "Skipped: {n} legacy .ppt file(s)"
msgstr "Übersprungen: {n} veraltete .ppt-Datei(en)"

msgid "Slide titles recovered from document properties:"
msgstr "Aus den Dokumenteigenschaften wiederhergestellte Folientitel:"

msgid "Slides recovered: {ok} of {total}"
msgstr "Wiederhergestellte Folien: {ok} von {total}"

msgid "The recovery folder groups salvaged content by kind: images/ and media/ hold pictures, audio and video; texts/ holds best-effort recovered text; charts/ holds chart XML plus cached data; parts/ holds every salvaged part in its original, raw form."
msgstr "Der Wiederherstellungsordner gruppiert den geretteten Inhalt nach Art: images/ und media/ enthalten Bilder, Audio und Video; texts/ enthält den bestmöglich wiederhergestellten Text; charts/ enthält Diagramm-XML samt zwischengespeicherter Daten; parts/ enthält jeden geretteten Teil in unveränderter Rohform."

msgid "Title"
msgstr "Titel"

msgid "Unknown pattern: {n} file(s) did not match any known corruption pattern."
msgstr "Unbekanntes Muster: {n} Datei(en) entsprachen keinem bekannten Schadensmuster."

msgid "Unrepairable: no recoverable content was found."
msgstr "Nicht reparierbar: Es wurde kein wiederherstellbarer Inhalt gefunden."

msgid "Value"
msgstr "Wert"

msgid "Verdict: {verdict} ({label})"
msgstr "Urteil: {verdict} ({label})"

msgid "Warnings:"
msgstr "Warnungen:"

msgid "corrupted: file tail truncated"
msgstr "beschädigt: Dateiende abgeschnitten"

msgid "corrupted: leading region overwritten with foreign data"
msgstr "beschädigt: Anfangsbereich mit fremden Daten überschrieben"

msgid "corrupted: leading region overwritten with zeros"
msgstr "beschädigt: Anfangsbereich mit Nullen überschrieben"

msgid "corrupted: mixture of two file versions"
msgstr "beschädigt: Mischung aus zwei Dateiversionen"

msgid "corrupted: unrecognized damage pattern"
msgstr "beschädigt: unbekanntes Schadensmuster"

msgid "intact PowerPoint package"
msgstr "intaktes PowerPoint-Paket"

msgid "not a ZIP-based file"
msgstr "keine ZIP-basierte Datei"

msgid "Downloading cloud-only file: {path}"
msgstr "Reine Cloud-Datei wird heruntergeladen: {path}"

msgid "corrupted: file is empty (all content lost)"
msgstr "beschädigt: Datei ist leer (gesamter Inhalt verloren)"

msgid "corrupted: file is (almost) entirely zero-filled"
msgstr "beschädigt: Datei ist (fast) vollständig mit Nullen gefüllt"

msgid "corrupted: interior region damaged, archive index intact"
msgstr "beschädigt: innerer Bereich beschädigt, Archivindex intakt"

msgid "corrupted: intact archive followed by foreign data"
msgstr "beschädigt: intaktes Archiv gefolgt von fremden Daten"

msgid "Removed {n} bytes of foreign data that followed the archive; the leading archive was kept unmodified."
msgstr "{n} Bytes fremder Daten, die dem Archiv folgten, wurden entfernt; das führende Archiv blieb unverändert erhalten."

msgid "Hint: no content survives inside this file. Check the OneDrive recycle bin, other devices' local copies, and any backups; version history rarely helps with this damage pattern."
msgstr "Hinweis: In dieser Datei ist kein Inhalt mehr erhalten. Prüfen Sie den OneDrive-Papierkorb, lokale Kopien auf anderen Geräten und etwaige Backups; der Versionsverlauf hilft bei diesem Schadensmuster selten."

msgid "Removed {e} stale reference(s) from {p} rebuilt part(s)."
msgstr "{e} veraltete Verweis(e) wurden aus {p} neu aufgebauten Teil(en) entfernt."

msgid "Unresolved references after repair: {n}"
msgstr "Nicht aufgelöste Verweise nach der Reparatur: {n}"

msgid "Note: these unresolved references existed in the original archive and were left untouched (the recovered file is byte-identical to the original)."
msgstr "Hinweis: Diese nicht aufgelösten Verweise waren bereits im ursprünglichen Archiv vorhanden und wurden unverändert belassen (die wiederhergestellte Datei ist byteidentisch mit dem Original)."

msgid "=== Repair summary ==="
msgstr "=== Reparatur-Zusammenfassung ==="

msgid "Repaired: {n} file(s)"
msgstr "Repariert: {n} Datei(en)"

msgid "Unrepairable: {n} file(s)"
msgstr "Nicht reparierbar: {n} Datei(en)"

msgid "Encrypted or legacy Office file(s) (not attempted): {n}"
msgstr "Verschlüsselte oder veraltete Office-Datei(en) (nicht versucht): {n}"

msgid "No content survives: {n} file(s)"
msgstr "Kein Inhalt erhalten: {n} Datei(en)"

msgid "Skipped (output exists): {n} file(s)"
msgstr "Übersprungen (Ausgabe existiert bereits): {n} Datei(en)"

msgid "Failed: {n} file(s)"
msgstr "Fehlgeschlagen: {n} Datei(en)"

msgid "Planned: {n} file(s)"
msgstr "Geplant: {n} Datei(en)"

msgid "dry run: nothing was written."
msgstr "dry-run: Es wurde nichts geschrieben."

msgid "Repairs:"
msgstr "Reparaturen:"

msgid "corrupted: overwritten with fragments of another ZIP archive"
msgstr "beschädigt: mit Fragmenten eines anderen ZIP-Archivs überschrieben"

msgid "corrupted: archive body largely overwritten in place"
msgstr "beschädigt: Archivkörper größtenteils an Ort und Stelle überschrieben"

msgid "=== Salvage summary ==="
msgstr "=== Rettungs-Zusammenfassung ==="

msgid "Nothing to salvage: the file is already an intact PowerPoint package."
msgstr "Nichts zu retten: Die Datei ist bereits ein intaktes PowerPoint-Paket."

msgid "Entries recovered: {n}"
msgstr "Wiederhergestellte Einträge: {n}"

msgid "Images carved: {n}"
msgstr "Ausgeschnittene Bilder: {n}"

msgid "Partial XML parts: {n}"
msgstr "Teilweise dekodierte XML-Teile: {n}"

msgid "Text lines recovered: {n}"
msgstr "Wiederhergestellte Textzeilen: {n}"

msgid "Note: carved images may contain unrelated data that overwrote the file."
msgstr "Hinweis: Ausgeschnittene Bilder können fremde Daten enthalten, die die Datei überschrieben haben."

msgid "Nothing could be salvaged from this file."
msgstr "Aus dieser Datei konnte nichts gerettet werden."

msgid "  restore candidate: {path} ({reason})"
msgstr "  Wiederherstellungskandidat: {path} ({reason})"

msgid "  (+{n} more restore candidates)"
msgstr "  (+{n} weitere Wiederherstellungskandidaten)"

msgid "same name and size"
msgstr "gleicher Name und gleiche Größe"

msgid "same size only"
msgstr "nur gleiche Größe"

msgid "same name only"
msgstr "nur gleicher Name"

msgid "=== Merge summary ==="
msgstr "=== Zusammenführungsübersicht ==="

msgid "Guarantee: {guarantee}"
msgstr "Garantie: {guarantee}"

msgid "Entries by source:"
msgstr "Einträge nach Quelle:"

msgid "Warning: part of the output comes from a different version and is not guaranteed to be identical to the original."
msgstr "Warnung: Ein Teil der Ausgabe stammt aus einer anderen Version und ist nicht garantiert mit dem Original identisch."

msgid "Notes:"
msgstr "Hinweise:"

msgid "Candidate-tier source not used: {path} (pass --allow-candidate, --yes, or confirm the prompt to include it)"
msgstr "Quelle der Stufe candidate nicht verwendet: {path} (geben Sie --allow-candidate, --yes an, oder bestätigen Sie die Abfrage, um sie einzuschließen)"

msgid "Lineage-tier source not used: {path} (pass --yes or confirm the prompt to include it)"
msgstr "Quelle der Stufe lineage nicht verwendet: {path} (geben Sie --yes an, oder bestätigen Sie die Abfrage, um sie einzuschließen)"

msgid "Source not used (not the same origin): {path}"
msgstr "Quelle nicht verwendet (kein gemeinsamer Ursprung): {path}"

msgid "Source: {path}"
msgstr "Quelle: {path}"

msgid "Tier: {tier}"
msgstr "Stufe: {tier}"

msgid "Size match: {value}"
msgstr "Größenübereinstimmung: {value}"

msgid "Triple ratio: {pct}%"
msgstr "Tripel-Quote: {pct}%"

msgid "Name ratio: {pct}%"
msgstr "Namens-Quote: {pct}%"

msgid "Media ratio: {pct}%"
msgstr "Medien-Quote: {pct}%"

msgid "Lineage score: {value}"
msgstr "Abstammungswert: {value}"

msgid "Use this source for the merge? [y/N] "
msgstr "Diese Quelle für die Zusammenführung verwenden? [y/N] "

msgid "Merge candidates:"
msgstr "Zusammenführungskandidaten:"

msgid "  {size} bytes: {files}"
msgstr "  {size} Bytes: {files}"

msgid "    These files may be the same saved version and could be repaired together into one file with pptrepair merge."
msgstr "    Diese Dateien könnten dieselbe gespeicherte Version sein und könnten mit pptrepair merge gemeinsam zu einer Datei repariert werden."

msgid "  lineage candidate: {path} (score {score})"
msgstr "  Abstammungskandidat: {path} (Wert {score})"

msgid "The merge target cannot be a file inside an archive: {path}. Extract it to a plain file and pass that instead."
msgstr "Das Merge-Ziel darf keine Datei innerhalb eines Archivs sein: {path}. Entpacken Sie es zu einer einfachen Datei und geben Sie diese stattdessen an."

msgid "Evidence:"
msgstr "Belege:"

msgid "Salvageable: {entries_ok}/{entries_total} entries, {slides_ok}/{slides_total} slides"
msgstr "Rettbar: {entries_ok}/{entries_total} Einträge, {slides_ok}/{slides_total} Folien"

msgid "Reference integrity: {n} unresolved reference(s) in {m} part(s)"
msgstr "Referenzintegrität: {n} nicht aufgelöste(r) Verweis(e) in {m} Teil(en)"

msgid "PowerPoint may offer a one-time repair on first open."
msgstr "PowerPoint bietet beim ersten Öffnen möglicherweise eine einmalige Reparatur an."

msgid "Timing integrity: {n} inconsistent reference(s) in {m} part(s)"
msgstr "Timing-Integrität: {n} inkonsistente(r) Verweis(e) in {m} Teil(en)"

msgid "Structure integrity: {n} required relationship(s) missing"
msgstr "Strukturintegrität: {n} erforderliche Beziehung(en) fehlend"

msgid "no {required} relationship"
msgstr "keine {required}-Beziehung"

